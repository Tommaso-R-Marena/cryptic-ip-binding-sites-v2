   "source": ["## Cell 9: ADAR2 — validate known coordinating residues"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Deep dive on ADAR2: check SASA for each of the 6 known IP6-coordinating residues\n",
    "\n",
    "import freesasa\n",
    "\n",
    "ADAR2_COORDINATING = {\n",
    "    376: 'K376', 519: 'K519', 522: 'R522', 651: 'R651', 672: 'K672', 687: 'W687'\n",
    "}\n",
    "\n",
    "adar2_path = clean_paths.get('ADAR2_AF')\n",
    "if adar2_path:\n",
    "    structure_sasa = freesasa.Structure(adar2_path)\n",
    "    result = freesasa.calc(structure_sasa)\n",
    "    print('ADAR2 known IP6-coordinating residues — SASA validation:')\n",
    "    print(f'{\"Residue\":<10} {\"Atom\":<8} {\"SASA (Å²)\":<12} {\"Buried (<10Å²)?\":<18}')\n",
    "    print('-' * 50)\n",
    "    found_any = False\n",
    "    for i in range(structure_sasa.nAtoms()):\n",
    "        res_num = int(structure_sasa.residueNumber(i).strip())\n",
    "        atom_name = structure_sasa.atomName(i).strip()\n",
    "        res_name = structure_sasa.residueName(i).strip()\n",
    "        if res_num in ADAR2_COORDINATING and atom_name in ('NZ', 'NH1', 'NH2', 'NE', 'NE1', 'ND1', 'NE2', 'CH2'):\n",
    "            sasa_val = result.atomArea(i)\n",
    "            buried = 'YES' if sasa_val < 10.0 else 'no'\n",
    "            label = ADAR2_COORDINATING[res_num]\n",
    "            print(f'{label:<10} {atom_name:<8} {sasa_val:<12.2f} {buried}')\n",
    "            found_any = True\n",
    "    if not found_any:\n",
    "        print('  Note: residue numbering may differ between AlphaFold and crystal. Searching nearby...')\n",
    "        # Print all Lys/Arg SASA to help identify equivalents\n",
    "        for i in range(structure_sasa.nAtoms()):\n",
    "            res_name = structure_sasa.residueName(i).strip()\n",
    "            atom_name = structure_sasa.atomName(i).strip()\n",
    "            if res_name in ('LYS', 'ARG') and atom_name in ('NZ', 'NH1', 'NH2') and result.atomArea(i) < 5.0:\n",
    "                res_num = structure_sasa.residueNumber(i).strip()\n",
    "                print(f'  Buried {res_name} {res_num} {atom_name}: SASA={result.atomArea(i):.2f} Å²')\n",
    "else:\n",
    "    print('ADAR2 structure not available.')"
