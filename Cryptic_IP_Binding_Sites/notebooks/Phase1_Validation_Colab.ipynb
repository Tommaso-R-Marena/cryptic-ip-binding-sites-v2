   "source": [
    "# Cryptic IP Binding Sites — Phase 1 Validation\n",
    "**Goal:** Validate the computational pipeline against known buried IP-binding proteins (positive controls)\n",
    "vs. classical surface-binding PH domains (negative controls).\n",
    "\n",
    "All tools install and run directly in this Colab environment — no local setup needed.\n",
    "\n",
    "### Proteins analyzed\n",
    "| Protein | PDB/AF | Type | Expected |\n",
    "|---------|--------|------|----------|\n",
    "| ADAR2 | AF-P78563-F1 | Positive control | High score |\n",
    "| Pds5B | 5HDT | Positive control | High score |\n",
    "| HDAC1 | 5ICN | Positive control | High score |\n",
    "| PLCδ1 PH | 1MAI | Negative control | Low score |\n",
    "| Btk PH | 1BTK | Negative control | Low score |\n",
    "| DAPP1 PH | 1FAO | Negative control | Low score |\n",
    "| Grp1 PH | 1FGY | Negative control | Low score |\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Cell 1: Install dependencies"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Install fpocket (compiled from source — fastest reliable method in Colab)\n",
    "import subprocess, sys, os\n",
    "\n",
    "# fpocket\n",
    "subprocess.run(['apt-get', 'install', '-y', '-q', 'fpocket'], check=False)\n",
    "result = subprocess.run(['which', 'fpocket'], capture_output=True, text=True)\n",
    "if not result.stdout.strip():\n",
    "    print('fpocket not in apt — building from source...')\n",
    "    subprocess.run('git clone https://github.com/Discngine/fpocket.git /tmp/fpocket_src && cd /tmp/fpocket_src && make && make install', shell=True, check=True)\n",
    "print('fpocket:', subprocess.run(['which', 'fpocket'], capture_output=True, text=True).stdout.strip() or 'not found — see fallback below')\n",
    "\n",
    "# freesasa (Python bindings)\n",
    "subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', 'freesasa'], check=True)\n",
    "\n",
    "# BioPython for structure parsing\n",
    "subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', 'biopython'], check=True)\n",
    "\n",
    "# Plotting\n",
    "subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', 'matplotlib', 'pandas', 'seaborn'], check=True)\n",
    "print('All dependencies ready.')"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Cell 2: Download all structures"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import urllib.request, os, gzip, shutil\n",
    "\n",
    "os.makedirs('/content/structures', exist_ok=True)\n",
    "\n",
    "STRUCTURES = {\n",
    "    'ADAR2_AF':    ('alphafold', 'P78563',  'ADAR2 AlphaFold',  'positive'),\n",
    "    'Pds5B_5HDT':  ('pdb',       '5HDT',    'Pds5B',            'positive'),\n",
    "    'HDAC1_5ICN':  ('pdb',       '5ICN',    'HDAC1',            'positive'),\n",
    "    'PLCd1_1MAI':  ('pdb',       '1MAI',    'PLCd1 PH',         'negative'),\n",
    "    'Btk_1BTK':    ('pdb',       '1BTK',    'Btk PH',           'negative'),\n",
    "    'DAPP1_1FAO':  ('pdb',       '1FAO',    'DAPP1 PH',         'negative'),\n",
    "    'Grp1_1FGY':   ('pdb',       '1FGY',    'Grp1 PH',          'negative'),\n",
    "}\n",
    "\n",
    "def download_structure(key, source, uid, label, control_type):\n",
    "    path = f'/content/structures/{key}.pdb'\n",
    "    if os.path.exists(path) and os.path.getsize(path) > 1000:\n",
    "        print(f'  {label}: already downloaded')\n",
    "        return path\n",
    "    if source == 'alphafold':\n",
    "        url = f'https://alphafold.ebi.ac.uk/files/AF-{uid}-F1-model_v4.pdb'\n",
    "    else:\n",
    "        url = f'https://files.rcsb.org/download/{uid}.pdb'\n",
    "    try:\n",
    "        urllib.request.urlretrieve(url, path)\n",
    "        print(f'  {label}: downloaded ({os.path.getsize(path)//1024} KB)')\n",
    "    except Exception as e:\n",
    "        print(f'  {label}: FAILED — {e}')\n",
    "        return None\n",
    "    return path\n",
    "\n",
    "print('Downloading structures...')\n",
    "paths = {}\n",
    "for key, (source, uid, label, ctype) in STRUCTURES.items():\n",
    "    paths[key] = download_structure(key, source, uid, label, ctype)\n",
    "print('Done.')"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Cell 3: Structure preparation (clean PDB, strip non-protein atoms)"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "from Bio import PDB\n",
    "from Bio.PDB import PDBParser, PDBIO, Select\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "os.makedirs('/content/structures_clean', exist_ok=True)\n",
    "\n",
    "class ProteinOnlySelect(Select):\n",
    "    def accept_residue(self, residue):\n",
    "        return residue.id[0] == ' '  # excludes HETATM (ligands, waters)\n",
    "\n",
    "parser = PDBParser(QUIET=True)\n",
    "clean_paths = {}\n",
    "\n",
    "for key, pdb_path in paths.items():\n",
    "    if pdb_path is None:\n",
    "        continue\n",
    "    label = STRUCTURES[key][2]\n",
    "    clean_path = f'/content/structures_clean/{key}_clean.pdb'\n",
    "    try:\n",
    "        structure = parser.get_structure(key, pdb_path)\n",
    "        io = PDBIO()\n",
    "        io.set_structure(structure)\n",
    "        io.save(clean_path, ProteinOnlySelect())\n",
    "        # Count residues\n",
    "        n_res = sum(1 for r in structure.get_residues() if r.id[0] == ' ')\n",
    "        print(f'  {label}: {n_res} residues')\n",
    "        clean_paths[key] = clean_path\n",
    "    except Exception as e:\n",
    "        print(f'  {label}: prep failed — {e}')\n",
    "\n",
    "print('Structure preparation complete.')"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Cell 4: Run fpocket on all structures"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import subprocess, re\n",
    "\n",
    "os.makedirs('/content/fpocket_results', exist_ok=True)\n",
    "\n",
    "# Check fpocket available\n",
    "fpocket_bin = subprocess.run(['which', 'fpocket'], capture_output=True, text=True).stdout.strip()\n",
    "if not fpocket_bin:\n",
    "    # Try /usr/local/bin\n",
    "    for candidate in ['/usr/local/bin/fpocket', '/tmp/fpocket_src/bin/fpocket']:\n",
    "        if os.path.exists(candidate):\n",
    "            fpocket_bin = candidate\n",
    "            break\n",
    "print(f'Using fpocket: {fpocket_bin}')\n",
    "\n",
    "fpocket_results = {}\n",
    "\n",
    "def run_fpocket(key, clean_path):\n",
    "    label = STRUCTURES[key][2]\n",
    "    out_dir = f'/content/fpocket_results/{key}'\n",
    "    os.makedirs(out_dir, exist_ok=True)\n",
    "    # fpocket writes output next to input file by default\n",
    "    result = subprocess.run(\n",
    "        [fpocket_bin, '-f', clean_path],\n",
    "        capture_output=True, text=True, cwd=out_dir\n",
    "    )\n",
    "    # fpocket creates {name}_out directory next to input\n",
    "    base = os.path.splitext(os.path.basename(clean_path))[0]\n",
    "    out_subdir = os.path.join(os.path.dirname(clean_path), f'{base}_out')\n",
    "    info_file = os.path.join(out_subdir, f'{base}_info.txt')\n",
    "    if os.path.exists(info_file):\n",
    "        return parse_fpocket_info(info_file, label)\n",
    "    else:\n",
    "        print(f'  {label}: fpocket info file not found at {info_file}')\n",
    "        print(f'  stdout: {result.stdout[:300]}')\n",
    "        print(f'  stderr: {result.stderr[:300]}')\n",
    "        return []\n",
    "\n",
    "def parse_fpocket_info(info_file, label):\n",
    "    pockets = []\n",
    "    current = {}\n",
    "    with open(info_file) as f:\n",
    "        for line in f:\n",
    "            line = line.strip()\n",
    "            if line.startswith('Pocket'):\n",
    "                if current:\n",
    "                    pockets.append(current)\n",
    "                m = re.match(r'Pocket (\\d+)', line)\n",
    "                current = {'pocket_id': int(m.group(1)) if m else len(pockets)+1}\n",
    "            elif ':' in line:\n",
    "                k, _, v = line.partition(':')\n",
    "                k = k.strip().lower().replace(' ', '_').replace('(', '').replace(')', '').replace('/', '_')\n",
    "                try:\n",
    "                    current[k] = float(v.strip())\n",
    "                except:\n",
    "                    current[k] = v.strip()\n",
    "        if current:\n",
    "            pockets.append(current)\n",
    "    print(f'  {label}: {len(pockets)} pockets detected')\n",
    "    return pockets\n",
    "\n",
    "for key, clean_path in clean_paths.items():\n",
    "    label = STRUCTURES[key][2]\n",
    "    if fpocket_bin:\n",
    "        print(f'Running fpocket on {label}...')\n",
    "        fpocket_results[key] = run_fpocket(key, clean_path)\n",
    "    else:\n",
    "        print(f'fpocket not available — skipping {label}')\n",
    "        fpocket_results[key] = []\n",
    "\n",
    "print('fpocket complete.')"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Cell 5: FreeSASA — solvent accessibility for all basic residues"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import freesasa\n",
    "import numpy as np\n",
    "\n",
    "BASIC_RESIDUES = {'ARG', 'LYS', 'HIS'}\n",
    "\n",
    "sasa_results = {}\n",
    "\n",
    "for key, clean_path in clean_paths.items():\n",
    "    label = STRUCTURES[key][2]\n",
    "    try:\n",
    "        structure_sasa = freesasa.Structure(clean_path)\n",
    "        result = freesasa.calc(structure_sasa)\n",
    "        # Per-residue SASA for basic residues\n",
    "        basic_sasas = []\n",
    "        buried_basic = 0\n",
    "        total_basic = 0\n",
    "        for i in range(structure_sasa.nAtoms()):\n",
    "            res_name = structure_sasa.residueName(i).strip()\n",
    "            atom_name = structure_sasa.atomName(i).strip()\n",
    "            if res_name in BASIC_RESIDUES and atom_name in ('NZ', 'NH1', 'NH2', 'ND1', 'NE2'):\n",
    "                sasa_val = result.atomArea(i)\n",
    "                basic_sasas.append(sasa_val)\n",
    "                total_basic += 1\n",
    "                if sasa_val < 10.0:\n",
    "                    buried_basic += 1\n",
    "        mean_basic_sasa = np.mean(basic_sasas) if basic_sasas else 0\n",
    "        pct_buried = (buried_basic / total_basic * 100) if total_basic > 0 else 0\n",
    "        sasa_results[key] = {\n",
    "            'total_sasa': result.totalArea(),\n",
    "            'mean_basic_sidechain_sasa': mean_basic_sasa,\n",
    "            'n_basic_residues': total_basic,\n",
    "            'n_buried_basic': buried_basic,\n",
    "            'pct_buried_basic': pct_buried,\n",
    "            'basic_sasas': basic_sasas,\n",
    "        }\n",
    "        print(f'  {label}: mean basic SASA={mean_basic_sasa:.1f} Å², buried basic={buried_basic}/{total_basic} ({pct_buried:.0f}%)')\n",
    "    except Exception as e:\n",
    "        print(f'  {label}: FreeSASA failed — {e}')\n",
    "        sasa_results[key] = {}\n",
    "\n",
    "print('FreeSASA complete.')"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Cell 6: Basic residue clustering — count Arg/Lys/His within 5 Å windows"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "from Bio.PDB import PDBParser, NeighborSearch\n",
    "import numpy as np\n",
    "\n",
    "# For each structure, find the maximum cluster of basic residues within 5Å of any point\n",
    "# This approximates 'how many basic residues line the best pocket'\n",
    "\n",
    "BASIC_RES = {'ARG', 'LYS', 'HIS'}\n",
    "BASIC_SIDECHAIN_ATOMS = {'NZ', 'NH1', 'NH2', 'NE', 'ND1', 'NE2', 'NE1'}\n",
    "\n",
    "# ADAR2 known coordinating residues (crystal structure, mapped to AF numbering)\n",
    "ADAR2_KNOWN_COORDS = {376, 519, 522, 651, 672}  # K376, K519, R522, R651, K672\n",
    "\n",
    "cluster_results = {}\n",
    "parser = PDBParser(QUIET=True)\n",
    "\n",
    "def get_basic_sidechain_atoms(structure):\n",
    "    atoms = []\n",
    "    for res in structure.get_residues():\n",
    "        if res.resname in BASIC_RES and res.id[0] == ' ':\n",
    "            for atom in res.get_atoms():\n",
    "                if atom.name in BASIC_SIDECHAIN_ATOMS:\n",
    "                    atoms.append(atom)\n",
    "    return atoms\n",
    "\n",
    "def max_basic_cluster(atoms, radius=5.0):\n",
    "    if not atoms:\n",
    "        return 0, None\n",
    "    ns = NeighborSearch(atoms)\n",
    "    best_count = 0\n",
    "    best_center = None\n",
    "    best_res_ids = []\n",
    "    seen_centers = set()\n",
    "    for atom in atoms:\n",
    "        coord = tuple(atom.coord.round(1))\n",
    "        if coord in seen_centers:\n",
    "            continue\n",
    "        seen_centers.add(coord)\n",
    "        neighbors = ns.search(atom.coord, radius, 'A')\n",
    "        res_ids = set(n.get_parent().id[1] for n in neighbors)\n",
    "        if len(res_ids) > best_count:\n",
    "            best_count = len(res_ids)\n",
    "            best_center = atom.coord\n",
    "            best_res_ids = res_ids\n",
    "    return best_count, best_center, best_res_ids\n",
    "\n",
    "for key, clean_path in clean_paths.items():\n",
    "    label = STRUCTURES[key][2]\n",
    "    try:\n",
    "        structure = parser.get_structure(key, clean_path)\n",
    "        basic_atoms = get_basic_sidechain_atoms(structure)\n",
    "        result = max_basic_cluster(basic_atoms)\n",
    "        best_count = result[0]\n",
    "        best_center = result[1]\n",
    "        best_res_ids = result[2] if len(result) > 2 else set()\n",
    "        # For ADAR2: check if known coordinating residues are recovered\n",
    "        if key == 'ADAR2_AF':\n",
    "            recovered = ADAR2_KNOWN_COORDS & best_res_ids\n",
    "            print(f'  {label}: max cluster = {best_count} basic residues within 5Å')\n",
    "            print(f'    Known coordinating residues recovered: {sorted(recovered)} / {sorted(ADAR2_KNOWN_COORDS)}')\n",
    "        else:\n",
    "            print(f'  {label}: max cluster = {best_count} basic residues within 5Å')\n",
    "        cluster_results[key] = {\n",
    "            'max_basic_cluster': best_count,\n",
    "            'best_center': best_center,\n",
    "            'best_res_ids': best_res_ids,\n",
    "        }\n",
    "    except Exception as e:\n",
    "        print(f'  {label}: clustering failed — {e}')\n",
    "        cluster_results[key] = {'max_basic_cluster': 0}\n",
    "\n",
    "print('Clustering complete.')"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Cell 7: Pocket depth estimation using geometric burial"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Approximate pocket depth: for the best basic cluster center,\n",
    "# measure the mean distance to the 10 nearest alpha-carbons (burial proxy).\n",
    "# More surrounded = deeper. Complement with SASA context.\n",
    "\n",
    "from Bio.PDB import PDBParser, NeighborSearch\n",
    "import numpy as np\n",
    "\n",
    "depth_results = {}\n",
    "\n",
    "def estimate_burial_depth(structure, center_coord, n_neighbors=20):\n",
    "    '''Mean distance to the N nearest CA atoms around a center point.\n",
    "    Lower value = more buried (surrounded by backbone).'''\n",
    "    ca_atoms = [a for a in structure.get_atoms() if a.name == 'CA']\n",
    "    if not ca_atoms:\n",
    "        return 0.0\n",
    "    ns = NeighborSearch(ca_atoms)\n",
    "    neighbors = ns.search(center_coord, 15.0, 'A')\n",
    "    if not neighbors:\n",
    "        return 999.0\n",
    "    dists = sorted([np.linalg.norm(a.coord - center_coord) for a in neighbors])\n",
    "    # Use the mean of closest N as burial indicator\n",
    "    top = dists[:min(n_neighbors, len(dists))]\n",
    "    return float(np.mean(top))\n",
    "\n",
    "def estimate_pocket_volume_proxy(structure, center_coord, radius=8.0):\n",
    "    '''Count CA atoms within radius — inverse density correlates with pocket volume.'''\n",
    "    ca_atoms = [a for a in structure.get_atoms() if a.name == 'CA']\n",
    "    ns = NeighborSearch(ca_atoms)\n",
    "    neighbors = ns.search(center_coord, radius, 'A')\n",
    "    # Volume proxy: more CA atoms nearby = smaller void space around center\n",
    "    # Pocket volume estimate using excluded volume approach\n",
    "    sphere_vol = (4/3) * np.pi * radius**3\n",
    "    ca_vol_each = 20.0  # Å³ per residue backbone\n",
    "    occupied = len(neighbors) * ca_vol_each\n",
    "    pocket_vol = max(0, sphere_vol - occupied)\n",
    "    return float(pocket_vol), len(neighbors)\n",
    "\n",
    "for key, clean_path in clean_paths.items():\n",
    "    label = STRUCTURES[key][2]\n",
    "    center = cluster_results.get(key, {}).get('best_center')\n",
    "    if center is None:\n",
    "        depth_results[key] = {'burial_depth': 0, 'pocket_vol_proxy': 0}\n",
    "        continue\n",
    "    try:\n",
    "        structure = parser.get_structure(key, clean_path)\n",
    "        depth = estimate_burial_depth(structure, center)\n",
    "        vol_proxy, n_ca = estimate_pocket_volume_proxy(structure, center)\n",
    "        depth_results[key] = {\n",
    "            'mean_ca_dist': depth,\n",
    "            'pocket_vol_proxy': vol_proxy,\n",
    "            'n_ca_neighbors': n_ca,\n",
    "        }\n",
    "        # Lower mean_ca_dist and more neighbors = more buried\n",
    "        burial_score = 1.0 / (depth + 1e-3)  # higher = more buried\n",
    "        depth_results[key]['burial_score'] = burial_score\n",
    "        print(f'  {label}: mean CA dist={depth:.1f}Å, pocket vol proxy={vol_proxy:.0f}Å³, n_CA_neighbors={n_ca}')\n",
    "    except Exception as e:\n",
    "        print(f'  {label}: depth failed — {e}')\n",
    "        depth_results[key] = {'burial_depth': 0, 'pocket_vol_proxy': 0, 'burial_score': 0}\n",
    "\n",
    "print('Depth estimation complete.')"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Cell 8: Composite scoring and final ranking"]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# Scoring criteria from the main document:\n",
    "# 1. Low mean SASA of basic sidechains (<10 Å² = high score)\n",
    "# 2. High number of basic residues in cluster (>=4 = passing)\n",
    "# 3. High burial (low mean CA distance)\n",
    "# 4. Pocket volume proxy in 300-800 Å³ range\n",
    "# 5. fpocket top pocket score (if available)\n",
    "\n",
    "rows = []\n",
    "\n",
    "for key, (source, uid, label, ctype) in STRUCTURES.items():\n",
    "    sasa = sasa_results.get(key, {})\n",
    "    cluster = cluster_results.get(key, {})\n",
    "    depth = depth_results.get(key, {})\n",
    "    fp = fpocket_results.get(key, [])\n",
    "\n",
    "    mean_basic_sasa = sasa.get('mean_basic_sidechain_sasa', 50.0)\n",
    "    pct_buried_basic = sasa.get('pct_buried_basic', 0.0)\n",
    "    n_basic = cluster.get('max_basic_cluster', 0)\n",
    "    mean_ca_dist = depth.get('mean_ca_dist', 20.0)\n",
    "    vol_proxy = depth.get('pocket_vol_proxy', 0)\n",
    "    burial_s = depth.get('burial_score', 0.0)\n",
    "\n",
    "    # Normalize each component 0-1 (higher = more cryptic IP-like)\n",
    "    # Component 1: SASA burial (lower SASA = higher score)\n",
    "    sasa_score = max(0, 1.0 - mean_basic_sasa / 60.0)\n",
    "\n",
    "    # Component 2: basic cluster count\n",
    "    cluster_score = min(1.0, n_basic / 8.0)\n",
    "\n",
    "    # Component 3: geometric burial (lower mean CA dist = more buried)\n",
    "    burial_norm = max(0, 1.0 - mean_ca_dist / 15.0)\n",
    "\n",
    "    # Component 4: pocket volume in target range (300-800 Å³)\n",
    "    if 300 <= vol_proxy <= 800:\n",
    "        vol_score = 1.0\n",
    "    elif vol_proxy < 300:\n",
    "        vol_score = vol_proxy / 300.0\n",
    "    else:\n",
    "        vol_score = max(0, 1.0 - (vol_proxy - 800) / 800.0)\n",
    "\n",
    "    # Component 5: fpocket druggability score (if available)\n",
    "    if fp:\n",
    "        best_drugg = max((p.get('druggability_score', 0) for p in fp), default=0)\n",
    "        fp_score = min(1.0, best_drugg)\n",
    "    else:\n",
    "        fp_score = 0.5  # neutral if not available\n",
    "\n",
    "    # Weighted composite (document weights: SASA most important)\n",
    "    composite = (\n",
    "        0.35 * sasa_score +\n",
    "        0.25 * cluster_score +\n",
    "        0.20 * burial_norm +\n",
    "        0.10 * vol_score +\n",
    "        0.10 * fp_score\n",
    "    )\n",
    "\n",
    "    rows.append({\n",
    "        'Key': key,\n",
    "        'Protein': label,\n",
    "        'Type': ctype,\n",
    "        'Mean Basic SASA (Å²)': round(mean_basic_sasa, 2),\n",
    "        '% Buried Basic': round(pct_buried_basic, 1),\n",
    "        'Max Basic Cluster': n_basic,\n",
    "        'Mean CA Dist (Å)': round(mean_ca_dist, 2),\n",
    "        'Vol Proxy (Å³)': round(vol_proxy, 0),\n",
    "        'SASA Score': round(sasa_score, 3),\n",
    "        'Cluster Score': round(cluster_score, 3),\n",
    "        'Burial Score': round(burial_norm, 3),\n",
    "        'Vol Score': round(vol_score, 3),\n",
    "        'fpocket Score': round(fp_score, 3),\n",
    "        'COMPOSITE SCORE': round(composite, 3),\n",
    "    })\n",
    "\n",
    "df = pd.DataFrame(rows).sort_values('COMPOSITE SCORE', ascending=False).reset_index(drop=True)\n",
    "df.index = df.index + 1  # rank from 1\n",
    "print('=== PHASE 1 VALIDATION RESULTS ===')\n",
    "print(df[['Protein', 'Type', 'Mean Basic SASA (Å²)', '% Buried Basic', 'Max Basic Cluster', 'COMPOSITE SCORE']].to_string())\n",
    "print()\n",
    "\n",
    "# Validation check\n",
    "positive_scores = df[df['Type']=='positive']['COMPOSITE SCORE'].values\n",
    "negative_scores = df[df['Type']=='negative']['COMPOSITE SCORE'].values\n",
    "print(f'Positive control mean score: {positive_scores.mean():.3f}')\n",
    "print(f'Negative control mean score: {negative_scores.mean():.3f}')\n",
    "separation = positive_scores.min() - negative_scores.max()\n",
    "print(f'Score separation (min positive - max negative): {separation:.3f}')\n",
    "if separation > 0:\n",
    "    print('PASS: Clean separation between positive and negative controls.')\n",
    "else:\n",
    "    print('WARNING: Overlap between controls — check SASA weights or depth thresholds.')\n",
    "\n",
    "# Save full results\n",
    "df.to_csv('/content/phase1_validation_results.csv', index_label='Rank')\n",
    "print('Results saved to /content/phase1_validation_results.csv')"
   ],
   "outputs": [],
   "execution_count": null
  },
